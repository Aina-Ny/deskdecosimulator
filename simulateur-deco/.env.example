# --- Accès à l'app (équipe interne) ---
# Mot de passe demandé à l'ouverture de l'app (protège aussi tes crédits IA).
APP_PASSWORD=change-moi
# Mot de passe de l'écran Admin (gestion du catalogue).
ADMIN_PASSWORD=change-moi-aussi

# --- Moteurs d'images (renseigne au moins un des deux) ---
# Google Gemini (Nano Banana) — clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle Gemini. Défaut : gemini-3.1-flash-image (Nano Banana 2).
GEMINI_MODEL=gemini-3.1-flash-image
# Optionnel : 1K, 2K ou 4K (selon le modèle). Laisser vide = défaut du modèle.
GEMINI_IMAGE_SIZE=

# Pollinations — clé secrète sk_ sur https://enter.pollinations.ai
POLLINATIONS_API_KEY=
# Modèle Pollinations acceptant plusieurs images en entrée.
POLLINATIONS_MODEL=google/gemini-2.5-flash-image

# Moteur sélectionné par défaut : gemini ou pollinations
DEFAULT_ENGINE=gemini

# --- Stockage du catalogue (partagé entre membres de l'équipe) ---
# Base Upstash Redis (gratuite) via Vercel > Storage > Upstash for Redis.
# Vercel crée ces deux variables automatiquement.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Développement local uniquement ---
# 1 = moteur factice (aucun appel IA, pour tester l'interface).
MOCK_ENGINE=0
